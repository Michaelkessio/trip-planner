# Postgres connection string (Supabase or Neon). Use the "pooled" connection string if offered.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth (for "Continue with Google") - from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY=""

# Google Maps - server-side key (enable: Places API, Geocoding API, Distance Matrix API)
GOOGLE_MAPS_API_KEY=""
# Google Maps - public key used for the embedded map iframe (restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Weather: no key needed (Open-Meteo is free/keyless). Nothing to set here.

# Amadeus for Developers (flights + hotels) - free self-service account at
# https://developers.amadeus.com. "test" uses the sandbox (limited routes/dates, no cost);
# switch to "production" only once you've upgraded to a paid Amadeus plan.
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_HOSTNAME="test"
